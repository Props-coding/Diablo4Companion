<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Plain .NET library with no WPF or Windows dependencies, so the crafting rules
    can be built and unit tested on any platform.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
