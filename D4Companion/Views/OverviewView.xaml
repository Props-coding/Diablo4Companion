<UserControl
    x:Class="D4Companion.Views.OverviewView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="clr-namespace:D4Companion.ViewModels"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=viewModels:OverviewViewModel}"
    d:DesignHeight="700" d:DesignWidth="1100">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style x:Key="StatTile" TargetType="Border" BasedOn="{StaticResource Companion.Card}">
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="MinWidth" Value="170" />
        </Style>
        <Style x:Key="StatNumber" TargetType="TextBlock" BasedOn="{StaticResource Companion.Text}">
            <Setter Property="FontFamily" Value="{StaticResource Companion.Font.Display}" />
            <Setter Property="FontSize" Value="30" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,4,24">
            <TextBlock Text="OVERVIEW" Style="{StaticResource Companion.Text.Eyebrow}" />
            <TextBlock Text="What should I do with my gear next?" Style="{StaticResource Companion.Text.PageTitle}" Margin="0,2,0,0" />
            <Border Style="{StaticResource Companion.GoldRule}" Margin="0,12,0,20" HorizontalAlignment="Left" Width="520" />

            <!-- The answer -->
            <Border Style="{StaticResource Companion.Card}" Padding="24" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding Answer}" Style="{StaticResource Companion.Text.Headline}" />
                        <TextBlock Text="{Binding AnswerDetail}" Style="{StaticResource Companion.Text.Muted}" FontSize="14" Margin="0,6,0,0" />
                        <TextBlock Style="{StaticResource Companion.Text.Muted}" Margin="0,12,0,0">
                            <Run Text="Build: " /><Run Text="{Binding BuildName, Mode=OneWay}" Foreground="{StaticResource Companion.Brush.Gold}" />
                            <Run Text="   Scanner: " /><Run Text="{Binding ScanStatus, Mode=OneWay}" Foreground="{StaticResource Companion.Brush.Text}" />
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <Button Content="Open Crafting Advisor" Command="{Binding OpenAdvisorCommand}" Style="{StaticResource Companion.Button.Primary}" />
                        <Button Content="Choose or import a build" Command="{Binding OpenBuildsCommand}" Style="{StaticResource Companion.Button.Link}" Margin="0,8,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Counts -->
            <WrapPanel Margin="0,0,0,16">
                <Border Style="{StaticResource StatTile}">
                    <StackPanel>
                        <TextBlock Text="{Binding SavedCount}" Style="{StaticResource StatNumber}" />
                        <TextBlock Text="Saved items" Style="{StaticResource Companion.Text.Muted}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatTile}">
                    <StackPanel>
                        <TextBlock Text="{Binding KeepCount}" Style="{StaticResource StatNumber}" Foreground="{StaticResource Companion.Brush.Success}" />
                        <TextBlock Text="Match the build" Style="{StaticResource Companion.Text.Muted}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatTile}">
                    <StackPanel>
                        <TextBlock Text="{Binding WorkCount}" Style="{StaticResource StatNumber}" Foreground="{StaticResource Companion.Brush.Danger}" />
                        <TextBlock Text="Need crafting" Style="{StaticResource Companion.Text.Muted}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatTile}">
                    <StackPanel>
                        <TextBlock Text="{Binding ReviewCount}" Style="{StaticResource StatNumber}" Foreground="{StaticResource Companion.Brush.Warning}" />
                        <TextBlock Text="Need checking" Style="{StaticResource Companion.Text.Muted}" />
                    </StackPanel>
                </Border>
            </WrapPanel>

            <!-- Next steps -->
            <Border Style="{StaticResource Companion.Card}" Visibility="{Binding HasNextSteps, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="Next steps" Style="{StaticResource Companion.Text.CardTitle}" />
                        <Button Content="See all gear" Command="{Binding OpenGearCommand}" Style="{StaticResource Companion.Button.Link}" HorizontalAlignment="Right" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding NextSteps}" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource Companion.Brush.Border}" BorderThickness="0,1,0,0" Padding="0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="160" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource Companion.Text}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding BuildMatch}" Style="{StaticResource Companion.Text.Muted}" VerticalAlignment="Center" />
                                        <Button Grid.Column="2" Content="{Binding NextAction}" Style="{StaticResource Companion.Button.Secondary}" MinWidth="150"
                                                Command="{Binding DataContext.OpenItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <TextBlock Text="The advisor compares items with your selected build. It does not judge overall item quality or calculate damage, and it never estimates crafting odds or costs."
                       Style="{StaticResource Companion.Text.Muted}" Margin="0,16,0,0" FontSize="12" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
