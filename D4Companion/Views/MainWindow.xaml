<mah:MetroWindow
    x:Class="D4Companion.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:D4Companion.Views"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:viewModels="clr-namespace:D4Companion.ViewModels"
    xmlns:loc="clr-namespace:D4Companion.Localization;assembly=D4Companion.Localization"
    xmlns:tb="http://www.hardcodet.net/taskbar"
    mah:DialogParticipation.Register="{Binding}"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=viewModels:MainWindowViewModel}"
    Title="{Binding WindowTitle}" Height="760" Width="1280" MinWidth="420" MinHeight="420"
    Topmost="{Binding IsTopMost}"
    Background="{StaticResource Companion.Brush.Obsidian}"
    WindowTitleBrush="{StaticResource Companion.Brush.Charcoal}"
    NonActiveWindowTitleBrush="{StaticResource Companion.Brush.Charcoal}"
    GlowBrush="{StaticResource Companion.Brush.Border}"
    BorderBrush="{StaticResource Companion.Brush.Border}"
    TitleCharacterCasing="Normal"
    WindowStartupLocation="CenterScreen">

    <b:Interaction.Triggers>
        <b:EventTrigger EventName="Closing">
            <b:InvokeCommandAction Command="{Binding WindowClosingCommand}"/>
        </b:EventTrigger>
        <b:EventTrigger EventName="Loaded">
            <b:InvokeCommandAction Command="{Binding ApplicationLoadedCommand}"/>
        </b:EventTrigger>
        <b:EventTrigger EventName="StateChanged">
            <b:InvokeCommandAction Command="{Binding WindowStateChangedCommand}" CommandParameter="{Binding}" />
        </b:EventTrigger>
    </b:Interaction.Triggers>

    <mah:MetroWindow.LeftWindowCommands>
        <mah:WindowCommands>
            <Button Command="{Binding LaunchGitHubCommand}" ToolTip="{loc:LocExtension rsToolTipGitHub}">
                <iconPacks:PackIconMaterial Width="22"
                                            Height="22"
                                            Kind="Github" />
            </Button>
            <Button Command="{Binding LaunchKofiCommand}" ToolTip="{loc:LocExtension rsToolTipKoFi}">
                <iconPacks:PackIconMaterial Width="22"
                                            Height="22"
                                            Kind="CoffeeOutline" />
            </Button>
            <Button Command="{Binding LaunchGitHubWikiCommand}" ToolTip="{loc:LocExtension rsToolTipGitHubWiki}">
                <iconPacks:PackIconMaterial Width="22"
                                            Height="22"
                                            Kind="HelpCircleOutline" />
            </Button>
        </mah:WindowCommands>
    </mah:MetroWindow.LeftWindowCommands>

    <mah:MetroWindow.RightWindowCommands>
        <mah:WindowCommands>
            <Button x:Name="CompactModeButton" Click="CompactModeButton_Click" ToolTip="Switch between the full window and the compact second-monitor view">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Width="16" Height="16" Kind="PictureInPictureBottomRight" VerticalAlignment="Center" />
                    <TextBlock x:Name="CompactModeButtonText" Text="Compact mode" Margin="6,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </mah:WindowCommands>
    </mah:MetroWindow.RightWindowCommands>

    <mah:MetroWindow.Resources>
        <Style x:Key="NavIcon" TargetType="iconPacks:PackIconMaterial">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>
    </mah:MetroWindow.Resources>

    <Grid>
        <tb:TaskbarIcon
            x:Name="NotifyIcon"
            Visibility="Visible"
            ToolTipText="Diablo IV Companion"
            IconSource="/Images/tray.ico"
            MenuActivation="LeftOrRightClick"
            PopupActivation="DoubleClick"
            DoubleClickCommand="{Binding NotifyIconDoubleClickCommand}">

            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu Background="#333333">
                    <MenuItem Header="Open" Command="{Binding NotifyIconOpenCommand}" />
                    <MenuItem Header="Exit" Command="{Binding NotifyIconExitCommand}" />
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>

        <!-- Full desktop layout -->
        <Grid x:Name="FullLayout">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Navigation -->
            <Border Grid.Column="0" Background="{StaticResource Companion.Brush.Charcoal}" BorderBrush="{StaticResource Companion.Brush.Border}" BorderThickness="0,0,1,0">
                <DockPanel Margin="0,16,0,12">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="22,0,0,22">
                        <TextBlock Text="D" FontFamily="Georgia" FontSize="26" FontWeight="Bold" Foreground="{StaticResource Companion.Brush.Crimson}" VerticalAlignment="Center" />
                        <TextBlock Text="D4 Companion" Style="{StaticResource Companion.Text}" FontSize="17" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Bottom: settings and the original tools -->
                    <StackPanel DockPanel.Dock="Bottom">
                        <Border Style="{StaticResource Companion.GoldRule}" Margin="20,8,20,8" />
                        <TextBlock Text="MORE TOOLS" Style="{StaticResource Companion.Text.Eyebrow}" Foreground="{StaticResource Companion.Brush.TextFaint}" Margin="24,4,0,4" />
                        <RadioButton x:Name="NavTrading" Tag="Trading" Checked="NavButton_Checked" Style="{StaticResource Companion.NavButton.Small}">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="ScaleBalance" Style="{StaticResource NavIcon}" />
                                <TextBlock Text="{loc:LocExtension rsCapTrading}" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavLogging" Tag="Logging" Checked="NavButton_Checked" Style="{StaticResource Companion.NavButton.Small}">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="TooltipTextOutline" Style="{StaticResource NavIcon}" />
                                <mah:Badged x:Name="LoggingBadge" Badge="{Binding BadgeCount}" BadgeBackground="{StaticResource Companion.Brush.Crimson}" BadgePlacementMode="Right">
                                    <TextBlock Text="{loc:LocExtension rsCapLogging}" Margin="0,0,14,0" />
                                </mah:Badged>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavDebug" Tag="Debug" Checked="NavButton_Checked" Style="{StaticResource Companion.NavButton.Small}">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="Bug" Style="{StaticResource NavIcon}" />
                                <TextBlock Text="{loc:LocExtension rsCapDebug}" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavSettings" Tag="Settings" Checked="NavButton_Checked" Style="{StaticResource Companion.NavButton}" Margin="10,8,10,2">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="Cog" Style="{StaticResource NavIcon}" />
                                <TextBlock Text="Settings" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>

                    <!-- Main navigation -->
                    <StackPanel>
                        <RadioButton x:Name="NavOverview" Tag="Overview" Checked="NavButton_Checked" Style="{StaticResource Companion.NavButton}">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="Home" Style="{StaticResource NavIcon}" />
                                <TextBlock Text="Overview" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavGear" Tag="Gear" Checked="NavButton_Checked" Style="{StaticResource Companion.NavButton}">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="ShieldHalfFull" Style="{StaticResource NavIcon}" />
                                <TextBlock Text="My Gear" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavCrafting" Tag="Crafting" Checked="NavButton_Checked" Style="{StaticResource Companion.NavButton}">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="Anvil" Style="{StaticResource NavIcon}" />
                                <TextBlock Text="Crafting Advisor" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavBuilds" Tag="Builds" Checked="NavButton_Checked" Style="{StaticResource Companion.NavButton}">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="BookOpenVariant" Style="{StaticResource NavIcon}" />
                                <TextBlock Text="Builds" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Page content. Pages are created once and kept, like the old menu did. -->
            <ContentControl x:Name="PageHost" Grid.Column="1" Margin="28,22,28,12" Focusable="False" />
        </Grid>

        <!-- Compact second-monitor layout -->
        <Grid x:Name="CompactLayout" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Background="{StaticResource Companion.Brush.Charcoal}" BorderBrush="{StaticResource Companion.Brush.Border}" BorderThickness="0,0,0,1" Padding="12,8">
                <Grid>
                    <TextBlock Text="Crafting Advisor" Style="{StaticResource Companion.Text}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <CheckBox x:Name="CompactTopMost" Content="Always on top" HorizontalAlignment="Right" VerticalAlignment="Center" IsChecked="True"
                              Checked="CompactTopMost_Changed" Unchecked="CompactTopMost_Changed" />
                </Grid>
            </Border>
            <ContentControl x:Name="CompactHost" Grid.Row="1" Focusable="False" />
        </Grid>
    </Grid>

</mah:MetroWindow>
