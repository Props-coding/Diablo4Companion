<UserControl
    x:Class="D4Companion.Views.CompactAdvisorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="clr-namespace:D4Companion.ViewModels"
    xmlns:local="clr-namespace:D4Companion.Views"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=viewModels:CraftingViewModel}"
    d:DesignHeight="800" d:DesignWidth="440">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <!-- Compact second-monitor mode: the selected build, the captured item and the next step. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="12">
            <ComboBox ItemsSource="{Binding PresetNames}" SelectedItem="{Binding SelectedPresetName, Mode=TwoWay}" />
            <TextBlock Text="{Binding LiveScanText}" Style="{StaticResource Companion.Text.Muted}" FontSize="12" Margin="0,8,0,0" />
            <Button Content="{Binding ScannerButtonText}" Command="{Binding ToggleScannerCommand}" Style="{StaticResource Companion.Button.Secondary}" Margin="0,8,0,0" />

            <Border Style="{StaticResource Companion.ActionBar}" Padding="12,10" Margin="0,10,0,10"
                    Visibility="{Binding ShowNextActionBar, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="{Binding NextActionTitle}" Style="{StaticResource Companion.Text}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding NextActionDetail}" Style="{StaticResource Companion.Text.Muted}" FontSize="12" Margin="0,2,0,8" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Content="Capture scan" Command="{Binding CaptureScanCommand}" Style="{StaticResource Companion.Button.Primary}" />
                        <Button Grid.Column="2" Content="Confirm item" Command="{Binding ConfirmCommand}" Style="{StaticResource Companion.Button.Secondary}" />
                    </Grid>
                    <Button Content="Rescan after crafting" Command="{Binding RescanAfterCraftingCommand}" Style="{StaticResource Companion.Button.Secondary}" Margin="0,8,0,0"
                            Visibility="{Binding ShowRescanAction, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Companion.Card}" Padding="12" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="{Binding ItemTitle}" Style="{StaticResource Companion.Text.CardTitle}" />
                    <ItemsControl ItemsSource="{Binding Affixes}" Margin="0,6,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource Companion.Text}" FontSize="13" Margin="0,0,8,0">
                                        <Run Text="{Binding DisplayName, Mode=OneWay}" /><Run Text=" · " Foreground="{StaticResource Companion.Brush.TextFaint}" /><Run Text="{Binding ValueDisplay, Mode=OneWay}" FontWeight="SemiBold" />
                                    </TextBlock>
                                    <Border Grid.Column="1" Style="{StaticResource Companion.StatusPill}">
                                        <TextBlock Text="{Binding StatusText}" FontSize="11" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="To correct values, use the Crafting Advisor in the full window." Style="{StaticResource Companion.Text.Muted}" FontSize="11" Margin="0,8,0,0" />
                    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Companion.Text}" FontSize="12" Foreground="{StaticResource Companion.Brush.Gold}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <local:RecommendationPanel />
            <local:CraftingPlanCard Margin="0,10,0,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
