<UserControl
    x:Class="D4Companion.Views.CraftingPlanCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="clr-namespace:D4Companion.ViewModels"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=viewModels:CraftingViewModel}"
    d:DesignHeight="400" d:DesignWidth="700">

    <!-- The full plan for the item, each step assuming the one before it worked, and what "done" covers.
         Shared by the Crafting Advisor page (under the item) and the compact view. DataContext: CraftingViewModel. -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <Border Style="{StaticResource Companion.Card}" Visibility="{Binding HasPlanCard, Converter={StaticResource BoolToVisibility}}">
        <StackPanel>
            <TextBlock Text="YOUR PLAN" Style="{StaticResource Companion.Text.Eyebrow}" />
            <TextBlock Text="{Binding PlanHeader}" Style="{StaticResource Companion.Text.CardTitle}" Margin="0,2,0,12"
                       Visibility="{Binding HasPlan, Converter={StaticResource BoolToVisibility}}" />

            <ItemsControl ItemsSource="{Binding PlanSteps}" Visibility="{Binding HasPlan, Converter={StaticResource BoolToVisibility}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="Step" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,8"
                                BorderBrush="{StaticResource Companion.Brush.Border}" Background="Transparent">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="24" Height="24" CornerRadius="12" Margin="0,0,12,0" VerticalAlignment="Top" BorderThickness="1"
                                        Background="{StaticResource Companion.Brush.GoldSoft}" BorderBrush="{StaticResource Companion.Brush.Gold}">
                                    <TextBlock Text="{Binding Number}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Companion.Brush.Gold}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Operation}" Style="{StaticResource Companion.Text}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <Border x:Name="NowTag" Style="{StaticResource Companion.Tag.Gold}" Visibility="Collapsed">
                                            <TextBlock Text="Now" FontSize="11" FontWeight="SemiBold" />
                                        </Border>
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{Binding Prism}" ItemTemplate="{StaticResource Companion.PrismChipTemplate}"
                                                  ItemsPanel="{StaticResource Companion.WrapPanel}" Margin="0,4,0,0"
                                                  Visibility="{Binding HasPrism, Converter={StaticResource BoolToVisibility}}" />
                                    <TextBlock Style="{StaticResource Companion.Text.Muted}" Margin="0,2,0,0">
                                        <Run Text="{Binding Detail, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource Companion.Text.Muted}" Visibility="{Binding HasAimFor, Converter={StaticResource BoolToVisibility}}">
                                        <Run Text="Aim for " /><Run Text="{Binding AimFor, Mode=OneWay}" Foreground="{StaticResource Companion.Brush.Gold}" />
                                    </TextBlock>
                                    <TextBlock Text="{Binding IfItWorks}" Style="{StaticResource Companion.Text.Muted}" FontSize="12" Margin="0,4,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsFirst}" Value="True">
                                <Setter TargetName="Step" Property="BorderBrush" Value="{StaticResource Companion.Brush.Gold}" />
                                <Setter TargetName="NowTag" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="{Binding PlanEndNote}" Style="{StaticResource Companion.Text}" FontSize="13" Margin="0,4,0,0"
                       Visibility="{Binding HasPlanEndNote, Converter={StaticResource BoolToVisibility}}" />

            <!-- What a match covers, stated separately so "done" never overpromises. -->
            <StackPanel Margin="0,10,0,0" Visibility="{Binding HasCompletion, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="Where the item stands now" Style="{StaticResource Companion.Text}" FontSize="13" FontWeight="SemiBold" />
                <TextBlock Text="{Binding AffixesStatement}" Style="{StaticResource Companion.Text.Muted}" Margin="0,2,0,0" />
                <TextBlock Text="{Binding ValuesStatement}" Style="{StaticResource Companion.Text.Muted}" />
                <TextBlock Text="{Binding GreaterStatement}" Style="{StaticResource Companion.Text.Muted}" />
            </StackPanel>

            <TextBlock Text="{Binding PlanDisclaimer, Mode=OneWay}" Style="{StaticResource Companion.Text.Muted}" FontSize="12" Margin="0,10,0,0"
                       Visibility="{Binding HasPlan, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>
    </Border>
</UserControl>
