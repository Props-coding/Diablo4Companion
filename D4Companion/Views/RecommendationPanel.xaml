<UserControl
    x:Class="D4Companion.Views.RecommendationPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="clr-namespace:D4Companion.ViewModels"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=viewModels:CraftingViewModel}"
    d:DesignHeight="800" d:DesignWidth="360">

    <!-- Shared by the Crafting Advisor page and the compact second-monitor view. DataContext: CraftingViewModel. -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <Border Style="{StaticResource Companion.Card}">
        <StackPanel>
            <TextBlock Text="RECOMMENDED NEXT STEP" Style="{StaticResource Companion.Text.Eyebrow}" />
            <TextBlock Text="{Binding Headline}" Style="{StaticResource Companion.Text.Headline}" Margin="0,8,0,0" />
            <TextBlock Text="{Binding Summary}" Style="{StaticResource Companion.Text.Muted}" FontSize="14" Margin="0,6,0,0" />

            <StackPanel Visibility="{Binding ShowRecommendation, Converter={StaticResource BoolToVisibility}}">
                <Border Style="{StaticResource Companion.GoldRule}" Margin="0,16" />

                <!-- Keep -->
                <StackPanel Margin="0,0,0,14" Visibility="{Binding HasKeep, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="Keep" Style="{StaticResource Companion.Text}" FontWeight="SemiBold" Foreground="{StaticResource Companion.Brush.Success}" />
                    <TextBlock Text="{Binding KeepText}" Style="{StaticResource Companion.Text.Muted}" Margin="0,2,0,0" />
                </StackPanel>

                <!-- Replace candidate -->
                <StackPanel Margin="0,0,0,14" Visibility="{Binding HasReplace, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="Candidate to replace" Style="{StaticResource Companion.Text}" FontWeight="SemiBold" Foreground="{StaticResource Companion.Brush.Danger}" />
                    <TextBlock Text="{Binding ReplaceText}" Style="{StaticResource Companion.Text.Muted}" Margin="0,2,0,0" />
                </StackPanel>
                <TextBlock Text="{Binding ReplaceNote}" Style="{StaticResource Companion.Text.Muted}" Margin="0,0,0,14"
                           Visibility="{Binding HasReplaceNote, Converter={StaticResource BoolToVisibility}}" />

                <!-- Target -->
                <StackPanel Margin="0,0,0,14" Visibility="{Binding HasTarget, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="Missing from your build" Style="{StaticResource Companion.Text}" FontWeight="SemiBold" Foreground="{StaticResource Companion.Brush.Gold}" />
                    <TextBlock Text="{Binding TargetText}" Style="{StaticResource Companion.Text.Muted}" Margin="0,2,0,0" />
                </StackPanel>

                <!-- Improve -->
                <StackPanel Margin="0,0,0,14" Visibility="{Binding HasImprove, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="Present but below target" Style="{StaticResource Companion.Text}" FontWeight="SemiBold" Foreground="{StaticResource Companion.Brush.Warning}" />
                    <TextBlock Text="{Binding ImproveText}" Style="{StaticResource Companion.Text.Muted}" Margin="0,2,0,0" />
                </StackPanel>

                <!-- Prisms -->
                <StackPanel Margin="0,0,0,14" Visibility="{Binding HasPrismHints, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="Relevant prism categories" Style="{StaticResource Companion.Text}" FontWeight="SemiBold" />
                    <ItemsControl ItemsSource="{Binding PrismHints}" Margin="0,2,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Style="{StaticResource Companion.Text.Muted}" Margin="0,1" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- In-game checks -->
                <Border Style="{StaticResource Companion.Callout.Warning}" Margin="0,0,0,14"
                        Visibility="{Binding HasInGameChecks, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="Before you spend" Style="{StaticResource Companion.Text}" FontWeight="SemiBold" Foreground="{StaticResource Companion.Brush.Warning}" />
                        <ItemsControl ItemsSource="{Binding InGameChecks}" Margin="0,4,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Style="{StaticResource Companion.Text}" FontSize="13" Margin="0,2">
                                        <Run Text="•" /> <Run Text="{Binding Mode=OneWay}" />
                                    </TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Three separate statements -->
                <Border Style="{StaticResource Companion.Callout.Info}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Companion.Text}" FontSize="13">
                            <Run Text="Matches the build: " FontWeight="SemiBold" /><Run Text="{Binding BuildMatchStatement, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Style="{StaticResource Companion.Text}" FontSize="13" Margin="0,6,0,0">
                            <Run Text="Is a good item: " FontWeight="SemiBold" /><Run Text="{Binding ItemQualityStatement, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Style="{StaticResource Companion.Text}" FontSize="13" Margin="0,6,0,0">
                            <Run Text="Improves damage: " FontWeight="SemiBold" /><Run Text="{Binding DamageStatement, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                </Border>
            </StackPanel>

            <Border Style="{StaticResource Companion.GoldRule}" Margin="0,4,0,14" />

            <!-- After crafting -->
            <TextBlock Text="After crafting" Style="{StaticResource Companion.Text}" FontWeight="SemiBold" />
            <TextBlock Text="Hover over the crafted item in-game, then rescan here to save the new result and compare before and after."
                       Style="{StaticResource Companion.Text.Muted}" Margin="0,2,0,10" />
            <Button Content="Rescan after crafting" Command="{Binding RescanAfterCraftingCommand}" Style="{StaticResource Companion.Button.Secondary}"
                    HorizontalAlignment="Stretch" ToolTip="Available after the item is saved to My Gear." />
            <TextBlock Text="Stop when the item meets your target." Style="{StaticResource Companion.Text.Muted}" Margin="0,12,0,0" />
        </StackPanel>
    </Border>
</UserControl>
