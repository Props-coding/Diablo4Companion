<UserControl
    x:Class="D4Companion.Views.RecommendationPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="clr-namespace:D4Companion.ViewModels"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=viewModels:CraftingViewModel}"
    d:DesignHeight="800" d:DesignWidth="340">

    <!-- Shared by the Crafting Advisor page and the compact second-monitor view. DataContext: CraftingViewModel.
         Leads with one action and the target stat. Everything else is folded away. -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <Border Style="{StaticResource Companion.Card}">
        <StackPanel>
            <TextBlock Text="RECOMMENDATION" Style="{StaticResource Companion.Text.Eyebrow}" />
            <TextBlock Text="{Binding Headline}" Style="{StaticResource Companion.Text.Headline}" Margin="0,6,0,0" />

            <StackPanel Orientation="Horizontal" Margin="0,10,0,0" Visibility="{Binding ShowTargetTag, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="Aim for" Style="{StaticResource Companion.Text.Muted}" VerticalAlignment="Center" />
                <Border Style="{StaticResource Companion.Tag.Gold}" Padding="10,3">
                    <TextBlock Text="{Binding TargetStat}" FontSize="13" FontWeight="SemiBold" />
                </Border>
            </StackPanel>

            <TextBlock Text="{Binding Summary}" Style="{StaticResource Companion.Text.Muted}" Margin="0,10,0,0" />

            <!-- The concrete step: where, what, which prism, on which affix, and why. -->
            <Border Style="{StaticResource Companion.Callout.Info}" Margin="0,12,0,0" Visibility="{Binding HasInstruction, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="WHAT TO DO" Style="{StaticResource Companion.Text.Eyebrow}" />
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="InstructionLabel" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Where" Style="{StaticResource Companion.Text.Muted}" Margin="0,0,12,6" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding InstructionStation}" Style="{StaticResource Companion.Text}" Margin="0,0,0,6" />

                        <TextBlock Grid.Row="1" Text="Operation" Style="{StaticResource Companion.Text.Muted}" Margin="0,0,12,6" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding InstructionOperation}" Style="{StaticResource Companion.Text}" FontWeight="SemiBold" Margin="0,0,0,6" />

                        <TextBlock Grid.Row="2" Text="Prism" Style="{StaticResource Companion.Text.Muted}" Margin="0,0,12,6"
                                   Visibility="{Binding HasInstructionPrism, Converter={StaticResource BoolToVisibility}}" />
                        <ItemsControl Grid.Row="2" Grid.Column="1" ItemsSource="{Binding InstructionPrism}" ItemTemplate="{StaticResource Companion.PrismChipTemplate}"
                                      ItemsPanel="{StaticResource Companion.WrapPanel}" Margin="0,0,0,4"
                                      Visibility="{Binding HasInstructionPrism, Converter={StaticResource BoolToVisibility}}" />

                        <TextBlock Grid.Row="3" Text="Change" Style="{StaticResource Companion.Text.Muted}" Margin="0,0,12,6"
                                   Visibility="{Binding HasInstructionAffected, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding InstructionAffected}" Style="{StaticResource Companion.Text}" Margin="0,0,0,6"
                                   Visibility="{Binding HasInstructionAffected, Converter={StaticResource BoolToVisibility}}" />

                        <TextBlock Grid.Row="4" Text="Aim for" Style="{StaticResource Companion.Text.Muted}" Margin="0,0,12,0"
                                   Visibility="{Binding HasInstructionDesired, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding InstructionDesired}" Style="{StaticResource Companion.Text}" Foreground="{StaticResource Companion.Brush.Gold}"
                                   Visibility="{Binding HasInstructionDesired, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>
                    <TextBlock Text="Why" Style="{StaticResource Companion.Text}" FontSize="13" FontWeight="SemiBold" Margin="0,10,0,2" />
                    <TextBlock Text="{Binding InstructionReason}" Style="{StaticResource Companion.Text.Muted}" />
                    <TextBlock Text="{Binding InstructionCaveat}" Style="{StaticResource Companion.Text.Muted}" FontSize="12" Margin="0,8,0,0"
                               Foreground="{StaticResource Companion.Brush.Warning}"
                               Visibility="{Binding HasInstructionCaveat, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Border>

            <StackPanel Visibility="{Binding ShowRecommendation, Converter={StaticResource BoolToVisibility}}" Margin="0,12,0,0">

                <!-- Every step for this item, each assuming the one before it worked. -->
                <Expander Style="{StaticResource Companion.Expander}" IsExpanded="True" Header="{Binding PlanHeader}"
                          Visibility="{Binding HasPlan, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding PlanSteps}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="22" Height="22" CornerRadius="11" Margin="0,0,10,0" VerticalAlignment="Top" BorderThickness="1"
                                                Background="{StaticResource Companion.Brush.GoldSoft}" BorderBrush="{StaticResource Companion.Brush.Gold}">
                                            <TextBlock Text="{Binding Number}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Companion.Brush.Gold}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Operation}" Style="{StaticResource Companion.Text}" FontWeight="SemiBold" />
                                            <ItemsControl ItemsSource="{Binding Prism}" ItemTemplate="{StaticResource Companion.PrismChipTemplate}"
                                                          ItemsPanel="{StaticResource Companion.WrapPanel}"
                                                          Visibility="{Binding HasPrism, Converter={StaticResource BoolToVisibility}}" />
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Companion.Text.Muted}" />
                                            <TextBlock Style="{StaticResource Companion.Text.Muted}" Visibility="{Binding HasAimFor, Converter={StaticResource BoolToVisibility}}">
                                                <Run Text="Aim for " /><Run Text="{Binding AimFor, Mode=OneWay}" Foreground="{StaticResource Companion.Brush.Gold}" />
                                            </TextBlock>
                                            <TextBlock Text="{Binding IfItWorks}" Style="{StaticResource Companion.Text.Muted}" FontSize="12" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding PlanEndNote}" Style="{StaticResource Companion.Text}" FontSize="13"
                                   Visibility="{Binding HasPlanEndNote, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Text="{Binding PlanDisclaimer, Mode=OneWay}" Style="{StaticResource Companion.Text.Muted}" FontSize="12" Margin="0,8,0,0" />
                    </StackPanel>
                </Expander>

                <Expander Style="{StaticResource Companion.Expander}" Header="Details" Visibility="{Binding HasDetails, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <StackPanel Margin="0,0,0,10" Visibility="{Binding HasKeep, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Keep" Style="{StaticResource Companion.Text}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Companion.Brush.Success}" />
                            <TextBlock Text="{Binding KeepText}" Style="{StaticResource Companion.Text.Muted}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,0,10" Visibility="{Binding HasReplace, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Replace" Style="{StaticResource Companion.Text}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Companion.Brush.Danger}" />
                            <TextBlock Text="{Binding ReplaceText}" Style="{StaticResource Companion.Text.Muted}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,0,10" Visibility="{Binding HasTarget, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Missing from your build" Style="{StaticResource Companion.Text}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Companion.Brush.Gold}" />
                            <TextBlock Text="{Binding TargetText}" Style="{StaticResource Companion.Text.Muted}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,0,10" Visibility="{Binding HasImprove, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Below your target" Style="{StaticResource Companion.Text}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Companion.Brush.Warning}" />
                            <TextBlock Text="{Binding ImproveText}" Style="{StaticResource Companion.Text.Muted}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,0,10" Visibility="{Binding HasProtected, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Protected" Style="{StaticResource Companion.Text}" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding ProtectedText}" Style="{StaticResource Companion.Text.Muted}" />
                        </StackPanel>
                        <TextBlock Text="{Binding ReplaceNote}" Style="{StaticResource Companion.Text.Muted}" FontSize="12"
                                   Visibility="{Binding HasReplaceNote, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </Expander>

                <Expander Style="{StaticResource Companion.Expander}" Header="Prism hints" Visibility="{Binding HasPrismHints, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding PrismHints}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,8">
                                        <TextBlock Text="{Binding AffixName}" Style="{StaticResource Companion.Text}" FontSize="13" />
                                        <ItemsControl ItemsSource="{Binding Prisms}" ItemTemplate="{StaticResource Companion.PrismChipTemplate}"
                                                      ItemsPanel="{StaticResource Companion.WrapPanel}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="A prism narrows the result to a category. It does not guarantee a specific affix."
                                   Style="{StaticResource Companion.Text.Muted}" FontSize="12" />
                    </StackPanel>
                </Expander>

                <Expander Style="{StaticResource Companion.Expander}" Header="Before you spend" Visibility="{Binding HasInGameChecks, Converter={StaticResource BoolToVisibility}}">
                    <ItemsControl ItemsSource="{Binding InGameChecks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Style="{StaticResource Companion.Text.Muted}" Margin="0,2">
                                    <Run Text="•" /> <Run Text="{Binding Mode=OneWay}" />
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Expander>

                <Expander Style="{StaticResource Companion.Expander}" Header="About this advice">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Companion.Text.Muted}">
                            <Run Text="Build match: " FontWeight="SemiBold" /><Run Text="{Binding BuildMatchStatement, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Style="{StaticResource Companion.Text.Muted}" Margin="0,6,0,0">
                            <Run Text="Item quality: " FontWeight="SemiBold" /><Run Text="{Binding ItemQualityStatement, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Style="{StaticResource Companion.Text.Muted}" Margin="0,6,0,0">
                            <Run Text="Damage: " FontWeight="SemiBold" /><Run Text="{Binding DamageStatement, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                </Expander>

                <CheckBox IsChecked="{Binding IncludeGreaterAffixes}" Margin="0,10,0,0"
                          ToolTip="Greater affixes are protected by default, because they are valuable. Tick this to let the advisor suggest replacing them.">
                    <TextBlock Text="Include greater affixes in suggestions" Style="{StaticResource Companion.Text.Muted}" />
                </CheckBox>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
